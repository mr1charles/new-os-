# HelixOS defaults: installers and apps from anywhere open with helixos-open (the Installer),
# which asks first, shows progress in the Dynamic Island, and says when it is done.
# Installed to /etc/xdg/mimeapps.list; a user's own ~/.config/mimeapps.list wins.
[Default Applications]
application/x-ms-dos-executable=helixos-open.desktop
application/x-msdownload=helixos-open.desktop
application/x-msdos-program=helixos-open.desktop
application/x-ms-shortcut=helixos-open.desktop
application/x-msi=helixos-open.desktop
application/x-ms-installer=helixos-open.desktop
application/x-wine-extension-msi=helixos-open.desktop
application/x-bat=helixos-open.desktop
application/vnd.microsoft.portable-executable=helixos-open.desktop
application/vnd.flatpak.ref=helixos-open.desktop
application/vnd.flatpak.repo=helixos-open.desktop
application/vnd.flatpak=helixos-open.desktop
application/x-appimage=helixos-open.desktop
application/vnd.appimage=helixos-open.desktop
application/x-iso9660-appimage=helixos-open.desktop
application/x-alpm-package=helixos-open.desktop
application/vnd.debian.binary-package=helixos-open.desktop
application/x-deb=helixos-open.desktop
application/x-rpm=helixos-open.desktop
application/vnd.android.package-archive=helixos-open.desktop
x-scheme-handler/appstream=helixos-open.desktop
