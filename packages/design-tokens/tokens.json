{
  "name": "newos",
  "font": {
    "family": "\"Inter\", \"SF Pro Text\", \"SF Pro Display\", \"Helvetica Neue\", system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", \"SF Mono\", \"Menlo\", monospace",
    "size": {
      "caption2": "10px",
      "caption": "11px",
      "footnote": "12px",
      "body": "13px",
      "callout": "15px",
      "title3": "17px",
      "title2": "22px",
      "title1": "28px",
      "largeTitle": "34px"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "radius": {
    "xs": "6px",
    "sm": "10px",
    "md": "14px",
    "lg": "22px",
    "xl": "28px",
    "pill": "999px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px"
  },
  "blur": {
    "material": "24px",
    "island": "40px"
  },
  "motion": {
    "spring": "cubic-bezier(0.2, 0.9, 0.2, 1.05)",
