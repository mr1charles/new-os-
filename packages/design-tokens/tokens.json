    "emphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "fast": "150ms",
    "normal": "250ms",
    "slow": "400ms"
  },
  "accents": {
    "blue": { "light": "#007AFF", "dark": "#0A84FF" },
    "purple": { "light": "#AF52DE", "dark": "#BF5AF2" },
