[Unit]
Description=NewOS Dual Space service
Documentation=https://github.com/mr1charles/new-os-/blob/main/docs/DUAL-SPACE.md
Before=greetd.service

[Service]
Type=dbus
BusName=org.newos.Spaces1
ExecStart=/usr/bin/newos-spacesd
StateDirectory=newos
# It creates accounts, so it needs root; keep everything else locked down.
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateTmp=true
RestrictRealtime=true
ReadWritePaths=/etc /var/lib/newos /home

[Install]
WantedBy=multi-user.target
