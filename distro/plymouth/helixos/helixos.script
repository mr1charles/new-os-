# HelixOS boot splash: black, and the logo fading in at the center of the screen, where the
# login screen's startup animation (shell/widgets/Startup.tsx, fromBoot) picks it up: the
# rest of the name slides out from its right, a flash, and the login screen appears.
# logo.png is shell/assets/brand/helixos-logo.svg rendered at 132 px, the size the shell uses.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y + 12);
logo.sprite.SetOpacity(0);

frame = 0;

fun ease_out(p) {
  if (p < 0) p = 0;
  if (p > 1) p = 1;
  return 1 - (1 - p) * (1 - p) * (1 - p);
}

# About 50 calls a second: fade in over 0.7 s while rising into place, then hold.
fun refresh() {
  frame++;
  p = ease_out((frame - 4) / 35);
  logo.sprite.SetOpacity(p);
  logo.sprite.SetY(logo.y + 12 * (1 - p));
}
Plymouth.SetRefreshFunction(refresh);

# Disk encryption password: a line of dots under the logo.
prompt.sprite = Sprite();
dots.sprite = Sprite();

fun display_password(text, bullets) {
  prompt.image = Image.Text(text, 1, 1, 1, 0.8, "Sans 13");
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt.image.GetWidth() / 2);
  prompt.sprite.SetY(logo.y + logo.image.GetHeight() + 48);
  shown = "";
  for (i = 0; i < bullets; i++) shown += "●";
  if (bullets == 0) shown = " ";
  dots.image = Image.Text(shown, 1, 1, 1, 1, "Sans 16");
  dots.sprite.SetImage(dots.image);
  dots.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - dots.image.GetWidth() / 2);
  dots.sprite.SetY(logo.y + logo.image.GetHeight() + 76);
  prompt.sprite.SetOpacity(1);
  dots.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password);

fun display_normal() {
  prompt.sprite.SetOpacity(0);
  dots.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal);

# Messages (e.g. "Checking disk") in small text at the bottom.
message.sprite = Sprite();
fun display_message(text) {
  message.image = Image.Text(text, 1, 1, 1, 0.6, "Sans 11");
  message.sprite.SetImage(message.image);
  message.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - message.image.GetWidth() / 2);
  message.sprite.SetY(Window.GetY() + Window.GetHeight() - 60);
}
Plymouth.SetMessageFunction(display_message);
